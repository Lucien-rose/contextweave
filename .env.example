# Public baseline only. Load with Node --env-file=.env or your service manager.
MOSS_CONFIG_DIR=./data/config
MOSS_DB_PATH=./data/contextweave.sqlite
MOSS_HTTP_HOST=127.0.0.1
MOSS_HTTP_PORT=2091
# Generate a unique owner token before HTTP startup.
MOSS_ADMIN_TOKEN=
MOSS_RECALL_VECTOR_MODE=off
CW_SEED_CHARS=4096
CW_MAIN_CHARS=6000
CW_TOTAL_CHARS=12000
CW_BACKGROUND_CHARS=1000
CW_BACKGROUND_ITEMS=1
CW_RECALL_ITEMS=5
CW_PORTRAIT_CHARS=4000
CW_HISTORY_CHARS=12000
CW_PORTRAIT_OPERATIONS=3
CW_MEMORY_CANDIDATES=2
CW_LIVING_DAYS=3
CW_EXPIRED_GRACE_DAYS=14
CW_TIMEZONE=UTC
