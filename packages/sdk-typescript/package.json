{
  "name": "@contextweave/sdk",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Typed client for ContextWeave HTTP API v1",
  "license": "Apache-2.0",
  "engines": { "node": ">=22" },
  "files": ["dist", "README.md", "LICENSE"],
  "main": "./dist/cjs/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/cjs/index.d.ts", "default": "./dist/cjs/index.js" }
    }
  },
  "scripts": { "build": "node scripts/build.js", "test": "node --test test/*.test.js" }
}
